<?xml version="1.0" encoding="utf-8"?>
<!-- 播放页:纯黑舞台 + 顶部/底部渐变控制层(3 秒自动隐藏,点击画面切换) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/playerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:resize_mode="fit"
        app:show_buffering="when_playing"
        app:use_controller="false" />

    <TextView
        android:id="@+id/gestureHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_pill"
        android:backgroundTint="#B3000000"
        android:paddingStart="16dp"
        android:paddingTop="9dp"
        android:paddingEnd="16dp"
        android:paddingBottom="9dp"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- 控制层 -->
    <LinearLayout
        android:id="@+id/playerOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 顶部:返回 / 标题 / 播放列表 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_player_top"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="2dp"
            android:paddingTop="6dp"
            android:paddingEnd="6dp"
            android:paddingBottom="18dp">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="返回"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_back"
                android:tint="#FFFFFF" />

            <TextView
                android:id="@+id/player_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:ellipsize="middle"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />

            <ImageButton
                android:id="@+id/btn_list"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="播放列表"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_list"
                android:tint="#FFFFFF" />
        </LinearLayout>

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 中部:上一集 / -10s / 播放暂停 / +10s / 下一集 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_prev"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="上一集"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_skip_prev"
                android:tint="#FFFFFF"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_seek_back"
                style="@style/ChipButton"
                android:layout_marginStart="10dp"
                android:text="-10s"
                android:textColor="#FFFFFF" />

            <ImageButton
                android:id="@+id/btn_play"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="播放/暂停"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_pause"
                android:tint="#FFFFFF" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_seek_fwd"
                style="@style/ChipButton"
                android:text="+10s"
                android:textColor="#FFFFFF" />

            <ImageButton
                android:id="@+id/btn_next"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="下一集"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_skip_next"
                android:tint="#FFFFFF"
                android:visibility="gone" />
        </LinearLayout>

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 底部:进度 + 时间 + 画面选项 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_player_bottom"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="26dp"
            android:paddingEnd="14dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_pos"
                    android:layout_width="54dp"
                    android:layout_height="wrap_content"
                    android:text="0:00"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <SeekBar
                    android:id="@+id/player_seek"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxHeight="3dp"
                    android:minHeight="3dp"
                    android:paddingStart="0dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="0dp"
                    android:paddingBottom="8dp"
                    android:progressBackgroundTint="#59FFFFFF"
                    android:progressTint="#FFFFFF"
                    android:splitTrack="false"
                    android:thumbTint="#FFFFFF" />

                <TextView
                    android:id="@+id/tv_dur"
                    android:layout_width="54dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="0:00"
                    android:textColor="#B3FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_speed"
                    style="@style/ChipButton"
                    android:text="1.0x"
                    android:textColor="#FFFFFF" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_aspect"
                    style="@style/ChipButton"
                    android:layout_marginStart="6dp"
                    android:text="适应"
                    android:textColor="#FFFFFF" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_rotate"
                    style="@style/ChipButton"
                    android:text="旋转"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
