<?xml version="1.0" encoding="utf-8"?>
<!--
  播放器「更多」面板(v1.9,B 站横屏三点菜单风格):
  第一段 图标入口(倍速播放/字幕/画面比例/画中画/外部播放器/锁定横屏),代码里按 6 等分填充
  第二段 定时关闭分段(不开启 / 15:00 / 30:00 / 60:00 / 自定义)
  第三段 开关行(自动连播 / 循环播放 / 镜像翻转)
  外层 NestedScrollView 保证小横屏不超高(超过屏幕可滚),深色半透明圆角背景由 bg_player_panel 提供。
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginTop="8dp"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_player_more"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/more_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="12dp">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_player_handle" />

        <!-- 第一段:图标入口行(代码里 6 等分填充,图标 24dp + 12sp 文案) -->
        <LinearLayout
            android:id="@+id/more_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />

        <!-- 第二段:定时关闭 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="16dp"
            android:text="定时关闭"
            android:textColor="#B3FFFFFF"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/sleep_seg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="12dp"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/seg_sleep_off"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@drawable/bg_player_seg_on"
                android:gravity="center"
                android:text="不开启"
                android:textColor="#F2F2F7"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/seg_sleep_15"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@drawable/bg_player_seg"
                android:gravity="center"
                android:text="15:00"
                android:textColor="#99FFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/seg_sleep_30"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@drawable/bg_player_seg"
                android:gravity="center"
                android:text="30:00"
                android:textColor="#99FFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/seg_sleep_60"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@drawable/bg_player_seg"
                android:gravity="center"
                android:text="60:00"
                android:textColor="#99FFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/seg_sleep_custom"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@drawable/bg_player_seg"
                android:gravity="center"
                android:text="自定义"
                android:textColor="#99FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 第三段:自动连播 -->
        <LinearLayout
            android:id="@+id/more_row_autonext"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_player_row"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="8dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="自动连播"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_skip_next"
                android:tint="#B3FFFFFF" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="自动连播"
                android:textColor="#E6FFFFFF"
                android:textSize="14sp" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/sw_autonext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:minHeight="0dp" />
        </LinearLayout>

        <!-- 第三段:循环播放(三段文本) -->
        <LinearLayout
            android:id="@+id/more_row_loop"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="循环播放"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_player_loop"
                android:tint="#B3FFFFFF" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="循环播放"
                android:textColor="#E6FFFFFF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/seg_loop_single"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="6dp"
                android:paddingTop="6dp"
                android:paddingEnd="6dp"
                android:paddingBottom="6dp"
                android:text="单集循环"
                android:textColor="#99FFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/seg_loop_list"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:paddingStart="6dp"
                android:paddingTop="6dp"
                android:paddingEnd="6dp"
                android:paddingBottom="6dp"
                android:text="列表循环"
                android:textColor="#99FFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/seg_loop_none"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:paddingStart="6dp"
                android:paddingTop="6dp"
                android:paddingEnd="6dp"
                android:paddingBottom="6dp"
                android:text="不循环"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 第三段:镜像翻转 -->
        <LinearLayout
            android:id="@+id/more_row_mirror"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_player_row"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="8dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="镜像翻转"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_player_mirror"
                android:tint="#B3FFFFFF" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="镜像翻转"
                android:textColor="#E6FFFFFF"
                android:textSize="14sp" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/sw_mirror"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:minHeight="0dp" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>