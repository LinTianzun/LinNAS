<?xml version="1.0" encoding="utf-8"?>
<!-- 播放器「更多」面板:图标 + 文案网格,替代简陋的列表弹窗 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_player_sheet"
    android:paddingBottom="16dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_player_handle" />

    <TextView
        android:id="@+id/more_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp"
        android:paddingBottom="4dp"
        android:text="更多"
        android:textColor="?attr/lText"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/more_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingTop="0dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp"
        android:textColor="?attr/lTextDim"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/more_grid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp" />
</LinearLayout>
