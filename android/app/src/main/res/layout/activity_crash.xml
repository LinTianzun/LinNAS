<?xml version="1.0" encoding="utf-8"?>
<!-- 崩溃页:主题色标题 + 卡片包裹的可选中堆栈 + 主/次按钮。保留全部现有 id。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/lInk"
    android:padding="@dimen/space_6">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="linNas 出错了"
        android:textColor="?attr/lDanger"
        android:textSize="@dimen/text_xl"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2"
        android:text="请截图或复制下面的信息发给开发者"
        android:textColor="?attr/lTextDim"
        android:textSize="@dimen/text_caption" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="@dimen/space_4"
        android:orientation="vertical"
        android:background="@drawable/bg_card"
        android:padding="@dimen/card_padding">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/crashText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/lText"
                android:textSize="@dimen/text_xs"
                android:lineSpacingExtra="3dp"
                android:textIsSelectable="true"
                android:fontFamily="monospace" />
        </ScrollView>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="@dimen/space_4">

        <Button
            android:id="@+id/btnCrashCopy"
            style="@style/BtnPrimary"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="复制错误信息" />

        <Button
            android:id="@+id/btnCrashClose"
            style="@style/BtnTonal"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/space_3"
            android:text="关闭" />
    </LinearLayout>
</LinearLayout>
