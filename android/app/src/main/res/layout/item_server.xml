<?xml version="1.0" encoding="utf-8"?>
<!-- 服务器行:圆角卡片 + 圆形图标底 + 点击涟漪。所有 id 与 Kotlin 引用保持一致。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_card"
    android:backgroundTint="?attr/lSurface"
    android:foreground="@drawable/bg_ripple"
    android:paddingStart="@dimen/card_padding"
    android:paddingEnd="@dimen/card_padding"
    android:paddingTop="@dimen/space_3"
    android:paddingBottom="@dimen/space_3"
    android:layout_marginBottom="@dimen/space_3">

    <ImageView
        android:layout_width="@dimen/tile_md"
        android:layout_height="@dimen/tile_md"
        android:padding="@dimen/space_3"
        android:background="@drawable/bg_icon_circle"
        android:src="@drawable/ic_wifi"
        android:tint="@color/mint"
        android:contentDescription="服务器" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/space_3"
        android:orientation="vertical">
        <TextView
            android:id="@+id/srvName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/lText"
            android:textSize="@dimen/text_md" />
        <TextView
            android:id="@+id/srvMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:textColor="?attr/lTextDim"
            android:textSize="@dimen/text_caption" />
    </LinearLayout>

    <ImageView
        android:layout_width="@dimen/icon_md"
        android:layout_height="@dimen/icon_md"
        android:layout_marginStart="@dimen/space_1"
        android:src="@drawable/ic_chevron"
        android:tint="?attr/lTextDim"
        android:contentDescription="连接" />
</LinearLayout>
