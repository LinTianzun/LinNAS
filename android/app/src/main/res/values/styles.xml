<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 排版 Typography -->
    <style name="TextDisplay">
        <item name="android:textSize">@dimen/text_2xl</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/lText</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>
    <style name="TextHeading">
        <item name="android:textSize">@dimen/text_xl</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/lText</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>
    <style name="TextSubheading">
        <item name="android:textSize">@dimen/text_lg</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/lText</item>
    </style>
    <style name="TextBody">
        <item name="android:textSize">@dimen/text_md</item>
        <item name="android:textColor">?attr/lText</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>
    <style name="TextCaption">
        <item name="android:textSize">@dimen/text_sm</item>
        <item name="android:textColor">?attr/lTextDim</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>
    <style name="TextOverline">
        <item name="android:textSize">@dimen/text_xs</item>
        <item name="android:textColor">?attr/lTextDim</item>
        <item name="android:letterSpacing">0.08</item>
    </style>
    <style name="SectionHeader">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/lText</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <!-- 卡片容器 -->
    <style name="CardContainer">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">@dimen/card_padding</item>
        <item name="android:layout_marginBottom">@dimen/space_3</item>
    </style>

    <!-- 分隔线 -->
    <style name="Divider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/stroke_hairline</item>
        <item name="android:background">@drawable/bg_divider</item>
    </style>

    <!-- 图标圆底 -->
    <style name="IconCircle">
        <item name="android:layout_width">@dimen/tile_md</item>
        <item name="android:layout_height">@dimen/tile_md</item>
        <item name="android:padding">9dp</item>
        <item name="android:background">@drawable/bg_icon_circle</item>
        <item name="android:tint">?attr/lPrimary</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <!-- 按钮 -->
    <style name="BtnPrimary">
        <item name="android:layout_height">@dimen/button_height</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">@dimen/space_4</item>
        <item name="android:paddingEnd">@dimen/space_4</item>
        <item name="android:gravity">center</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_sm</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/lOnPrimary</item>
        <item name="android:background">@drawable/bg_button_primary</item>
    </style>
    <style name="BtnTonal">
        <item name="android:layout_height">@dimen/button_height</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">@dimen/space_4</item>
        <item name="android:paddingEnd">@dimen/space_4</item>
        <item name="android:gravity">center</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_sm</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/lText</item>
        <item name="android:background">@drawable/bg_button_tonal</item>
    </style>
</resources>
