<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 扫码配对 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Android 13+ 通知权限(上传进度通知) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 14 前台服务(上传队列 dataSync) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- M2 上传相册视频用 -->
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- 旧版本回退 -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <application
        android:name=".LinNasApp"
        android:label="linNas"
        android:icon="@drawable/ic_launcher_vec"
        android:theme="@style/Theme.LinNas"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- 崩溃详情页 -->
        <activity android:name=".CrashActivity" android:exported="false" />
        <!-- 保险箱 -->
        <activity
            android:name=".VaultActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <!-- M7 回收站 -->
        <activity
            android:name=".TrashActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <!-- M7 分享管理 -->
        <activity
            android:name=".SharesActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <!-- M7 多用户登录 -->
        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <!-- P2 操作日志(仅管理员可见) -->
        <activity
            android:name=".AuditActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <!-- M3 内置播放器页;P1 支持画中画 -->
        <activity
            android:name=".PlayerActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout"
            android:supportsPictureInPicture="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.LinNas.Player" />
        <!-- 扫码配对:覆盖 zxing 库自带的横屏声明,改为竖屏 -->
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:screenOrientation="portrait"
            tools:replace="android:screenOrientation" />
        <!-- M2 后台上传服务 -->
        <service
            android:name=".upload.UploadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
