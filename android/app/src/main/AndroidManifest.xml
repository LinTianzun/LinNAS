<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 扫码配对 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Android 13+ 通知权限(上传进度通知) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 14 前台服务(上传队列 dataSync) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- M2 上传相册视频用 -->
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- 旧版本回退 -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- v1.8.0 生物识别(保险箱解锁 / 生物识别登录) -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />
    <!-- 应用内下载更新包后拉起系统安装器(Android 8.0+ 必须声明,否则安装器不响应) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".LinNasApp"
        android:label="linNas"
        android:icon="@drawable/ic_launcher_vec"
        android:theme="@style/Theme.LinNas"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- 崩溃详情页 -->
        <activity android:name=".CrashActivity" android:exported="false" />
        <!-- 保险箱 -->
        <activity
            android:name=".VaultActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <!-- M7 回收站 -->
        <activity
            android:name=".TrashActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <!-- M7 分享管理 -->
        <activity
            android:name=".SharesActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <!-- M7 多用户登录 -->
        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <!-- P2 操作日志(仅管理员可见) -->
        <activity
            android:name=".AuditActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <!-- v1.7.0 活跃会话管理 -->
        <activity
            android:name=".SessionsActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <!-- v1.7.0 用户管理(管理员) -->
        <activity
            android:name=".UserAdminActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <!-- v1.7.0 维护与索引(管理员) -->
        <activity
            android:name=".MaintenanceActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <!-- v1.7.0 网络唤醒 -->
        <activity
            android:name=".WolActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <!-- v1.7.0 存储库管理(管理员) -->
        <activity
            android:name=".LibraryAdminActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <!-- v1.8.0 版本检查 / 更新 -->
        <activity
            android:name=".VersionCheckActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity
            android:name=".ImageActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.LinNas" />
        <!-- M3 内置播放器页;P1 支持画中画 -->
        <activity
            android:name=".PlayerActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout"
            android:supportsPictureInPicture="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.LinNas.Player" />
        <!-- 扫码配对:覆盖 zxing 库自带的横屏声明,改为竖屏 -->
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:screenOrientation="portrait"
            tools:replace="android:screenOrientation" />
        <!-- M2 后台上传服务 -->
        <service
            android:name=".upload.UploadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <!-- v1.8.0 统一下载 / 打包下载前台服务 -->
        <service
            android:name=".transfer.TransferService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <!-- v1.8.0 下载完成后打开/分享应用私有文件 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />
    </application>
</manifest>
